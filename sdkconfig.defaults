# Target hardware: ESP32-S3-WROOM-1 development board.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Keep logs away from the Modbus CDC interface and release UART0 GPIO43/GPIO44.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# One TinyUSB CDC-ACM interface is used as the Modbus RTU transport.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=256
CONFIG_TINYUSB_CDC_TX_BUFSIZE=256
CONFIG_TINYUSB_CDC_EP_BUFSIZE=256
